{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "tool-dev-clip-studio"
    }
  ],
  "tags": [
    "clip-studio",
    "video",
    "youtube",
    "shorts",
    "creator",
    "viral",
    "productivity"
  ],
  "system_prompt_addendum": "When user mentions #clip-studio or shares a YouTube link to extract clips, use tool-dev-clip-studio to analyze viral retention hotspots, timestamps, and hooks. Format findings clearly with timecodes and punchy scripts.",
  "user_message_prefix_template": "[ClipStudio] {user_message}",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": [
        "https://i.ytimg.com",
        "https://img.youtube.com"
      ]
    },
    "views": [
      {
        "name": "main",
        "title": "ClipStudio AI",
        "default": true,
        "default_size": { "w": 860, "h": 620 },
        "min_size": { "w": 480, "h": 360 }
      }
    ],
    "host_api": {
      "tools": ["tool-dev-clip-studio"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "img-src": [
        "https://i.ytimg.com",
        "https://img.youtube.com",
        "data:"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
